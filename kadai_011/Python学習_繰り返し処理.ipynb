      "cell_type": "code",
      "source": [
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "#配列arryの各要素をfor文を使って順に出力\n",
        "for array in array:\n",
        "  print(array)\n",
        "#配列arryの各要素をwhile文を使って順に出力\n",
        "i = 0  #カウンタ変数\n",
        "while i < len(array):\n",
        "  #配列要素iを出力\n",
        "  print(array[i])\n",
        "  #カウンタを1つ進める\n",
        "  i+= 1\n",
        "  #配列要素の最後に達したら処理終了\n",
        "  if i == len(array):\n",
        "    break\n"
      ],
