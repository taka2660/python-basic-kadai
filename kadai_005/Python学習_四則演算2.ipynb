        "#課題：台形の面積の計算結果を出力\n",
        "upper_line = 10\n",
        "lower_line = 20\n",
        "height = 5\n",
        "area = (upper_line + lower_line) * height / 2\n",
        "#計算結果の代入をフォーマット済文字列リテラルを使って表記\n",
        "print(f\"台形の面積は{area}cm²です。\")"
