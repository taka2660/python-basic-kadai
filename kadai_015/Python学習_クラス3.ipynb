      "source": [
        "class Human:  #Humanクラスを定義\n",
        "  def __init__(self, name, age):\n",
        "    #下記属性値を定義\n",
        "      self.name = name\n",
        "      self.age = age\n",
        "    #値を出力するメソッドを定義\n",
        "  def printinfo(self):\n",
        "      print(self.name, self.age)\n",
        "#インスタンス化インスタンス名をhumanとする\n",
        "human = Human(\"太郎\", \"54\")\n",
        "human.printinfo() #値を出力するメソッド"
      ],
